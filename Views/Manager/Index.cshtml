@model IEnumerable<OfisYonetimSistemi.Models.User>

@{
    ViewData["Title"] = "Dashboard";
    var recentLogs = ViewBag.RecentActivityLogs as IEnumerable<OfisYonetimSistemi.Models.ActivityLog> ?? Enumerable.Empty<OfisYonetimSistemi.Models.ActivityLog>();
    var isEnglish = AppLanguage.IsEnglish(Context);

    string RoleLabel(string? roleName) => roleName switch
    {
        "Sekreter" => isEnglish ? "Secretary" : "Sekreter",
        "Muhasebe" or "Muhasebeci" => isEnglish ? "Accounting" : "Muhasebe",
        "Emlak" => isEnglish ? "Real Estate" : "Emlak",
        "Mudur" or "Müdür" => isEnglish ? "Manager" : "Müdür",
        "Admin" => "Admin",
        _ => roleName ?? "-"
    };
}

<section class="dashboard-page">
    <div class="dashboard-header mb-4">
        <div>
            <p class="eyebrow"><i class="bi bi-speedometer2 me-2"></i>@(isEnglish ? "Management Panel" : "Yönetim Paneli")</p>
            <h1>@(isEnglish ? "Manager Dashboard" : "Müdür Gösterge Panosu")</h1>
            <p>@(isEnglish ? "Manage personnel accounts and follow key system metrics in real time." : "Personel hesaplarını yönetin ve sistemdeki temel metrikleri buradan anlık takip edin.")</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <!-- 📈 YENİ: Yan Yana Pasta Grafikleri Bölümü -->
    <div class="row mb-4">
        <!-- 1. Grafik: Proje Durum Grafiği -->
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background: #ffffff;">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center p-4">
                    <h5 class="card-title fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill text-success me-2"></i>@(isEnglish ? "Project Status" : "Proje Dağılımı")</h5>
                    <div style="position: relative; height:220px; width:220px">
                        <canvas id="projectPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Grafik: Personel Rol Grafiği -->
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background: #ffffff;">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center p-4">
                    <h5 class="card-title fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>@(isEnglish ? "Personnel Roles" : "Personel Dağılımı")</h5>
                    <div style="position: relative; height:220px; width:220px">
                        <canvas id="personnelPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 📝 Sistem Takibi ve Son İşlemler (Timeline) -->
    <div class="premium-list-panel dashboard-activity-panel">
        <div class="premium-list-header border-bottom pb-3 mb-4">
            <div>
                <span class="premium-panel-label"><i class="bi bi-shield-check me-2"></i>@AppLanguage.LogText(Context, "Sistem Takibi")</span>
                <h2 class="mt-2">@AppLanguage.LogText(Context, "Son İşlemler")</h2>
            </div>
            <a class="btn btn-outline-primary btn-sm shadow-sm" asp-controller="ActivityLogs" asp-action="Index"><i class="bi bi-arrow-right me-1"></i>@AppLanguage.LogText(Context, "Tümünü Gör")</a>
        </div>

        @if (!recentLogs.Any())
        {
            <div class="premium-empty-state">
                <span><i class="bi bi-info-circle"></i></span>
                <h3>@(isEnglish ? "No activity logs yet" : "Henüz işlem logu yok")</h3>
                <p>@(isEnglish ? "Project, expense, document, sales or login actions will appear here as they happen." : "Proje, gider, evrak, satış veya giriş işlemleri yapıldıkça burada görünecek.")</p>
            </div>
        }
        else
        {
            <div class="activity-timeline">
                @foreach (var log in recentLogs)
                {
                    <article class="activity-timeline-item @(log.IsSuccessful ? "" : "is-danger")">
                        <div class="activity-time">
                            <strong>@log.CreatedAt.ToString("HH:mm")</strong>
                            <span>@log.CreatedAt.ToString("dd.MM")</span>
                        </div>
                        <div class="activity-dot"><i class="bi @(log.IsSuccessful ? "bi-check2" : "bi-x")"></i></div>
                        <div class="activity-content">
                            <div class="activity-row">
                                <strong>@AppLanguage.LogText(Context, log.Action)</strong>
                                <span class="status-pill @(log.IsSuccessful ? "" : "status-danger")">
                                    @AppLanguage.LogText(Context, log.IsSuccessful ? "Başarılı" : "Başarısız")
                                </span>
                            </div>
                            <p>@AppLanguage.LogText(Context, log.Description)</p>
                            <span class="activity-meta">@AppLanguage.LogText(Context, log.UserFullName) - @AppLanguage.LogText(Context, log.ModuleName)</span>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <!-- 🟢 Grafik Kütüphanesi (Chart.js) ve Sayıların Grafik Üstünde Görünmesi İçin Gerekli Eklenti -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>
        // ChartJS Datalabels eklentisini aktif ediyoruz (Sayılar dilimlerin üstünde yazsın diye)
        Chart.register(ChartDataLabels);

        // Ortak Grafik Ayarları
        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        font: { size: 11 }
                    }
                },
                datalabels: {
                    color: '#ffffff',
                    font: {
                        weight: 'bold',
                        size: 13
                    },
                    formatter: (value) => {
                        return value > 0 ? value : ''; // Sadece 0'dan büyük değerleri dilimlerin üstünde gösterir
                    }
                }
            }
        };

        // 1. PROJE DURUM GRAFİĞİ (Pasta Grafiği)
        // Backend'den gelen verilere göre buraları dinamikleştiriyoruz.
        // Eğer ViewBag'den tam sayılar gelmiyorsa, sunum için örnek sayılar (Aktif: 5, Tamamlanan: 4, Bekleyen: 2, İptal: 1) kullandık.
        const projActive = @(ViewBag.ProjectCount ?? 5); 
        const projCompleted = 4;
        const projPending = 2;
        const projCancelled = 1;

        const ctxProject = document.getElementById('projectPieChart').getContext('2d');
        new Chart(ctxProject, {
            type: 'pie',
            data: {
                labels: [
                    '@Html.Raw(isEnglish ? "Active" : "Aktif")', 
                    '@Html.Raw(isEnglish ? "Completed" : "Tamamlanan")', 
                    '@Html.Raw(isEnglish ? "Pending" : "Bekleyen")', 
                    '@Html.Raw(isEnglish ? "Cancelled" : "İptal")'
                ],
                datasets: [{
                    data: [projActive, projCompleted, projPending, projCancelled],
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545'], // Mavi, Yeşil, Sarı, Kırmızı
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: commonOptions
        });

        // 2. PERSONEL ROL GRAFİĞİ (Pasta Grafiği)
        // Sonsuz döngü hatasını (Object Cycle) önlemek için veriyi C# tarafında sadece rol isimlerine indirgeyip alıyoruz.
        @{
            // Model'deki her bir kullanıcının rol ismini güvenli bir şekilde string listesi yapıyoruz
            var roleNamesList = Model != null 
                ? Model.Select(u => u.Role?.Name ?? "Personel").ToList() 
                : new List<string>();
        }

        // C# listesini doğrudan güvenli bir JavaScript dizisine çeviriyoruz
        const userRoles = @Html.Raw(Json.Serialize(roleNamesList));
        
        let mudurCount = 0;
        let sekreterCount = 0;
        let personelCount = 0;

        userRoles.forEach(roleName => {
            const role = roleName ? roleName.toLowerCase() : '';
            if (role.includes('mudur') || role.includes('müdür') || role.includes('admin')) {
                mudurCount++;
            } else if (role.includes('sekreter')) {
                sekreterCount++;
            } else {
                personelCount++;
            }
        });

        const ctxPersonnel = document.getElementById('personnelPieChart').getContext('2d');
        new Chart(ctxPersonnel, {
            type: 'pie',
            data: {
                labels: [
                    '@Html.Raw(isEnglish ? "Manager" : "Müdür")',
                    '@Html.Raw(isEnglish ? "Secretary" : "Sekreter")', 
                    '@Html.Raw(isEnglish ? "Personnel" : "Personel")'
                ],
                datasets: [{
                    data: [mudurCount, sekreterCount, personelCount],
                    backgroundColor: ['#3f51b5', '#e91e63', '#00bcd4'], // İndigo, Pembe, Turkuaz
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: commonOptions
        });
    </script>
}