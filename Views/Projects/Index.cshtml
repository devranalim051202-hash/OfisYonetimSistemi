@model IEnumerable<OfisYonetimSistemi.Models.Project>

@{
    ViewData["Title"] = AppLanguage.T(Context, "Projects");
    bool canCreateProject = ViewBag.CanCreateProject ?? false;
    bool canEditProject = ViewBag.CanEditProject ?? false;
    bool canDeleteProject = ViewBag.CanDeleteProject ?? false;
    var isEnglish = AppLanguage.IsEnglish(Context);
}

<section class="dashboard-page">
    <div class="dashboard-header projects-hero">
        <div>
            <p class="eyebrow"><i class="bi bi-briefcase-fill me-2"></i>@AppLanguage.T(Context, "ProjectManagement")</p>
            <h1>@AppLanguage.T(Context, "Projects")</h1>
            <p>@AppLanguage.T(Context, "ProjectManagementText")</p>
        </div>
        @if (canCreateProject)
        {
            <a class="btn btn-primary shadow-sm" asp-controller="Projects" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>@AppLanguage.T(Context, "ProjectAdd")</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div class="premium-list-panel projects-portfolio-panel mt-4">
        <div class="premium-list-header border-bottom pb-3 mb-4">
            <div>
                <span class="premium-panel-label"><i class="bi bi-card-list me-2"></i>@AppLanguage.T(Context, "ProjectList")</span>
                <h2 class="mt-2">@AppLanguage.T(Context, "ProjectPortfolio")</h2>
            </div>
            <div class="projects-panel-actions d-flex align-items-center gap-3">
                <div class="position-relative search-container" style="min-width: 220px;">
                    <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%); z-index: 5;"></i>
                    <input type="text" id="projectSearchInput" class="form-control form-control-sm search-input" maxlength="20" placeholder="@(isEnglish ? "Search Projects..." : "Proje Ara...")" style="padding-left: 32px; border-radius: 20px; height: 36px; border: 1px solid #dfe5ef; box-shadow: none;" />
                    <div id="projectSuggestions" class="search-suggestions-dropdown d-none"></div>
                </div>
                <span class="premium-count bg-light"><i class="bi bi-collection me-2"></i>@Model.Count() @AppLanguage.T(Context, "ProjectCount")</span>
                @if (canCreateProject)
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Projects" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>@AppLanguage.T(Context, "ProjectNew")</a>
                }
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="premium-empty-state">
                <span><i class="bi bi-folder-plus"></i></span>
                <h3>@AppLanguage.T(Context, "ProjectEmptyTitle")</h3>
                <p>@AppLanguage.T(Context, "ProjectEmptyText")</p>
                @if (canCreateProject)
                {
                    <a class="btn btn-primary" asp-controller="Projects" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>@AppLanguage.T(Context, "ProjectFirstAdd")</a>
                }
            </div>
        }
        else
        {
            <div class="project-card-grid">
                @foreach (var project in Model)
                {
                    var finishDate = project.EndDate?.ToString("dd.MM.yyyy") ?? AppLanguage.T(Context, "InProgress");
                    var coverImage = project.ProjectImages.FirstOrDefault(i => i.IsCover) ?? project.ProjectImages.FirstOrDefault();
                    var cardStyle = coverImage != null ? $"background-image: url('{coverImage.FilePath}');" : "";
                    <article class="project-card project-card-photo project-portfolio-card @(coverImage != null ? "has-project-photo" : "no-project-photo")" style="@cardStyle">
                        <div class="project-card-photo-overlay"></div>
                        @if (coverImage == null)
                        {
                            <div class="project-placeholder-visual">
                                <i class="bi bi-buildings"></i>
                                <span>@AppLanguage.T(Context, "ProjectSmartOffice")</span>
                            </div>
                        }
                        <div class="project-card-top">
                            <span class="project-monogram shadow-sm">@project.Name.Substring(0, 1).ToUpper()</span>
                            <span class="status-pill premium-status shadow-sm"><i class="bi bi-activity me-2"></i>@project.Status</span>
                        </div>

                        <div class="project-card-body">
                            <h3>@project.Name</h3>
                            <p>@(string.IsNullOrWhiteSpace(project.Description) ? AppLanguage.T(Context, "ProjectNoDescription") : project.Description)</p>
                        </div>

                        <div class="project-meta-grid">
                            <div>
                                <span><i class="bi bi-geo-alt me-2 text-primary"></i>@AppLanguage.T(Context, "Location")</span>
                                <strong>@(project.Location ?? "-")</strong>
                            </div>
                            <div>
                                <span><i class="bi bi-calendar-event me-2 text-success"></i>@AppLanguage.T(Context, "Start")</span>
                                <strong>@project.StartDate.ToString("dd.MM.yyyy")</strong>
                            </div>
                            <div>
                                <span><i class="bi bi-calendar-check me-2 text-danger"></i>@AppLanguage.T(Context, "End")</span>
                                <strong>@finishDate</strong>
                            </div>
                        </div>

                        <div class="project-card-actions mt-3">
                            <a class="btn btn-primary flex-grow-1" asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id"><i class="bi bi-arrow-right-circle me-1"></i>@AppLanguage.T(Context, "ProjectEnter")</a>
                            @if (canEditProject)
                            {
                                <a class="btn btn-outline-secondary px-3" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id" title='@AppLanguage.T(Context, "Edit")'><i class="bi bi-pencil-square"></i></a>
                            }
                            @if (canDeleteProject)
                            {
                                <a class="btn btn-outline-danger px-3" asp-controller="Projects" asp-action="Delete" asp-route-id="@project.Id" title='@AppLanguage.T(Context, "Delete")'><i class="bi bi-trash"></i></a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<style>
.search-container {
    position: relative;
    min-width: 220px;
}
.search-suggestions-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 1050;
    background: #ffffff;
    border: 1px solid #dfe5ef;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.1);
    max-height: 250px;
    overflow-y: auto;
    margin-top: 6px;
}
.suggestion-item {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    cursor: pointer;
    font-size: 14px;
    color: #1e293b;
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.15s ease;
}
.suggestion-item:last-child {
    border-bottom: none;
}
.suggestion-item:hover {
    background: #f8fafc;
}
.suggestion-item .suggestion-icon {
    margin-right: 10px;
    color: #64748b;
}
.did-you-mean-item {
    background: #f0f7ff;
    color: #2563eb;
    font-weight: 600;
    font-style: italic;
    border-bottom: 1px dashed #bfdbfe;
}
.did-you-mean-item:hover {
    background: #e0f2fe;
}
.search-highlight {
    border: 2px dashed #2563eb !important;
    animation: pulseHighlight 1.5s ease-in-out;
}
@@keyframes pulseHighlight {
    0% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4);
    }
    70% {
        box-shadow: 0 0 0 10px rgba(37, 99, 235, 0);
    }
    100% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
    }
}
</style>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("projectSearchInput");
    const suggestionsDropdown = document.getElementById("projectSuggestions");
    const projectCards = document.querySelectorAll(".project-portfolio-card");

    // Gather projects from the DOM
    const projects = [];
    projectCards.forEach(card => {
        const titleEl = card.querySelector(".project-card-body h3");
        if (titleEl) {
            projects.push({
                name: titleEl.textContent.trim(),
                element: card
            });
        }
    });

    // Turkish lowercase conversion
    function trLowercase(str) {
        return str.replace(/İ/g, 'i')
                  .replace(/I/g, 'ı')
                  .replace(/Ş/g, 'ş')
                  .replace(/Ğ/g, 'ğ')
                  .replace(/Ü/g, 'ü')
                  .replace(/Ö/g, 'ö')
                  .replace(/Ç/g, 'ç')
                  .toLowerCase();
    }

    // Levenshtein distance for fuzzy matching
    function getLevenshteinDistance(a, b) {
        const matrix = [];
        for (let i = 0; i <= b.length; i++) {
            matrix[i] = [i];
        }
        for (let j = 0; j <= a.length; j++) {
            matrix[0][j] = j;
        }
        for (let i = 1; i <= b.length; i++) {
            for (let j = 1; j <= a.length; j++) {
                if (b.charAt(i - 1) === a.charAt(j - 1)) {
                    matrix[i][j] = matrix[i - 1][j - 1];
                } else {
                    matrix[i][j] = Math.min(
                        matrix[i - 1][j - 1] + 1, // substitution
                        matrix[i][j - 1] + 1,     // insertion
                        matrix[i - 1][j] + 1      // deletion
                    );
                }
            }
        }
        return matrix[b.length][a.length];
    }

    // Handle suggestion selection
    function selectSuggestion(projectName) {
        searchInput.value = projectName;
        suggestionsDropdown.classList.add("d-none");
        filterAndDisplay(projectName);

        // Highlight and scroll to the selected project card
        const match = projects.find(p => trLowercase(p.name) === trLowercase(projectName));
        if (match && match.element) {
            match.element.scrollIntoView({ behavior: 'smooth', block: 'center' });
            match.element.classList.add("search-highlight");
            setTimeout(() => {
                match.element.classList.remove("search-highlight");
            }, 2500);
        }
    }

    function filterAndDisplay(query) {
        const cleanQuery = trLowercase(query.trim());

        if (!cleanQuery) {
            projectCards.forEach(card => card.style.display = "");
            return;
        }

        projectCards.forEach(card => {
            const titleEl = card.querySelector(".project-card-body h3");
            const descEl = card.querySelector(".project-card-body p");
            const locEl = card.querySelector(".project-meta-grid");
            
            const titleText = titleEl ? trLowercase(titleEl.textContent) : "";
            const descText = descEl ? trLowercase(descEl.textContent) : "";
            const locText = locEl ? trLowercase(locEl.textContent) : "";

            if (titleText.includes(cleanQuery) || descText.includes(cleanQuery) || locText.includes(cleanQuery)) {
                card.style.display = "";
            } else {
                card.style.display = "none";
            }
        });
    }

    // Input event listener
    searchInput.addEventListener("input", function () {
        const query = searchInput.value;
        const cleanQuery = trLowercase(query.trim());

        filterAndDisplay(query);

        if (!cleanQuery) {
            suggestionsDropdown.innerHTML = "";
            suggestionsDropdown.classList.add("d-none");
            return;
        }

        // Generate suggestions sorted alphabetically (A-Z)
        const exactMatches = projects
            .filter(p => trLowercase(p.name).includes(cleanQuery))
            .map(p => p.name)
            .sort((a, b) => a.localeCompare(b, "tr"));

        suggestionsDropdown.innerHTML = "";

        if (exactMatches.length > 0) {
            exactMatches.forEach(projectName => {
                const item = document.createElement("div");
                item.className = "suggestion-item";
                item.innerHTML = `<i class="bi bi-briefcase suggestion-icon"></i><span>${projectName}</span>`;
                item.addEventListener("click", () => selectSuggestion(projectName));
                suggestionsDropdown.appendChild(item);
            });
            suggestionsDropdown.classList.remove("d-none");
        } else {
            // Fuzzy search ("Did you mean?")
            let bestMatch = null;
            let minDistance = 999;

            projects.forEach(p => {
                const nameLower = trLowercase(p.name);
                const distance = getLevenshteinDistance(cleanQuery, nameLower);
                if (distance < minDistance) {
                    minDistance = distance;
                    bestMatch = p.name;
                }
            });

            // Threshold: length-dependent threshold to avoid silly matches on very short queries
            const threshold = Math.max(2, Math.floor(cleanQuery.length * 0.6));
            if (bestMatch && minDistance <= threshold) {
                const didYouMean = document.createElement("div");
                didYouMean.className = "suggestion-item did-you-mean-item";
                const text = (trLowercase("@isEnglish") === "true" ? "Did you mean: " : "Bunu mu demek istediniz: ") + `<strong>${bestMatch}</strong>?`;
                didYouMean.innerHTML = `<i class="bi bi-question-circle suggestion-icon text-primary"></i><span>${text}</span>`;
                didYouMean.addEventListener("click", () => selectSuggestion(bestMatch));
                suggestionsDropdown.appendChild(didYouMean);
                suggestionsDropdown.classList.remove("d-none");
            } else {
                suggestionsDropdown.classList.add("d-none");
            }
        }
    });

    // Close dropdown on click outside
    document.addEventListener("click", function (e) {
        if (!searchInput.contains(e.target) && !suggestionsDropdown.contains(e.target)) {
            suggestionsDropdown.classList.add("d-none");
        }
    });

    // Show suggestions on focus if query exists
    searchInput.addEventListener("focus", function () {
        if (searchInput.value.trim() && suggestionsDropdown.children.length > 0) {
            suggestionsDropdown.classList.remove("d-none");
        }
    });
});
</script>
}
